+	})
+
+	t.Run("invalid token returns error", func(t *testing.T) {
+		sr := json.NewStreamReader(strings.NewReader(`{bad}`))
+		if _, err := sr.Next(); err == nil {
+			t.Fatal("expected error, got nil")
+		}
+	})
+}
