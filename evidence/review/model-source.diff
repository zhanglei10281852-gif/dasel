+		if diff := cmp.Diff(expected, got); diff != "" {
+			t.Fatalf("unexpected values: %s", diff)
+		}
+	})
+
+	t.Run("invalid json returns error after previous values", func(t *testing.T) {
+		sr := json.NewStreamReader(strings.NewReader(`{"a": 1} {"a":`))
