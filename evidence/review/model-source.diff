+func streamValues(t *testing.T, r io.Reader) []any {
+	t.Helper()
+	sr := json.NewStreamReader(r)
+	var got []any
+	for {
+		v, err := sr.Next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			t.Fatalf("unexpected error: %v", err)
+		}
+		gv, err := v.GoValue()
+		if err != nil {
+			t.Fatalf("unexpected error converting value: %v", err)
+		}
+		got = append(got, gv)
+	}
+	return got
+}
